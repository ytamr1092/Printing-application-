# Public app configuration
EXPO_PUBLIC_APP_ID=
EXPO_PUBLIC_OAUTH_PORTAL_URL=
EXPO_PUBLIC_OAUTH_SERVER_URL=
EXPO_PUBLIC_OWNER_OPEN_ID=
EXPO_PUBLIC_OWNER_NAME=
EXPO_PUBLIC_API_BASE_URL=

# Comma-separated, exact web frontend origins trusted by the API (production)
CORS_ALLOWED_ORIGINS=

# Server-only configuration; never put real values in a public build
# Required. In production use a random string of at least 32 characters (e.g. `openssl rand -hex 32`)
JWT_SECRET=
DATABASE_URL=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
OPENAI_API_KEY=
